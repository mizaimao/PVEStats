#!/usr/bin/env bash
# The dashboard kiosk's monitor and the dashboard itself, off and on again,
# from here. No sudo: the kiosk service and the screen machine keep running.
#
#   tui/kiosk off      monitor off and the dashboard paused: nothing is
#                      drawn, and no machine is asked for anything
#   tui/kiosk on       monitor on and the dashboard running again
#   tui/kiosk status   which it is now
#
# "off" lasts until "on", a deploy (tui/deploy restarts the dashboard) or a
# restart of the screen machine, each of which brings it back on.

set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/machines.sh"

# On the screen machine, inside the kiosk's Wayland session: every output
# wlr-randr lists, and the dashboard's process.
session='export WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/$(id -u)
    outputs() { wlr-randr | awk "/^[^ ]/ {print \$1}"; }
    pid=$(pgrep -x pvestats-tui) || { echo "the dashboard is not running"; exit 1; }'

case "${1:-status}" in
    off)
        on_screen "$session"'
            kill -STOP $pid
            for o in $(outputs); do wlr-randr --output $o --off; done
            echo "off: monitor off, dashboard paused"' ;;
    on)
        # The monitor first, so the dashboard's next frame is seen.
        on_screen "$session"'
            for o in $(outputs); do wlr-randr --output $o --on; done
            kill -CONT $pid
            echo "on: monitor on, dashboard running"' ;;
    status)
        on_screen "$session"'
            case $(ps -o stat= -p $pid) in T*) d=paused ;; *) d=running ;; esac
            m=$(wlr-randr | awk "/Enabled:/ {print \$2}" | sort -u | tr "\n" " ")
            echo "dashboard $d; monitor enabled: $m"' ;;
    *)
        echo "usage: tui/kiosk off | on | status" >&2
        exit 2 ;;
esac
