#!/usr/bin/env bash
# The dashboard kiosk's monitor and the dashboard itself, off and on again,
# from here. No sudo: the kiosk service and the screen machine keep running.
#
#   tui/kiosk off      monitor off and the dashboard paused: nothing is
#                      drawn, and no machine is asked for anything
#   tui/kiosk on       monitor on and the dashboard running again
#   tui/kiosk status   which it is now
#   tui/kiosk <command>  any other of tui/kiosk-remote's commands, e.g.
#                      "schedule set 03:00-05:00"
#
# It runs tui/kiosk-remote on the screen machine, the same controls
# moose-mcp uses. "off" lasts until "on", a deploy (tui/deploy restarts the
# dashboard) or a restart of the screen machine, each of which brings it
# back on.

set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/machines.sh"

case "${1:-status}" in
    off | on) command="kiosk $1" ;;
    *) command="$*" ;;
esac
command=${command:-status}
# Quoted for the remote shell: kiosk-remote checks it word by word.
on_screen "$S/tui/kiosk-remote $(printf '%q ' $command)"
