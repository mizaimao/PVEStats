#!/usr/bin/env bash
# Builds "PVEStats Terminal.app" in the repo root: the terminal dashboard in
# a Terminal window on the Mac, with the app's own icon. Click it and
# Terminal opens on the dashboard, which redraws to fit whenever the window
# is resized. q or Esc closes it.
#
#   tui/make-mac-app [pvestats-tui]
#
# The argument is the dashboard built for macOS; by default the one in
# tui/target/release (cargo build --release in tui/, on a Mac: macserver,
# not Frank's laptop, except when he says so). It is copied into the app,
# which reads .env and config.yaml from this repo, like the app in the
# browser. The app writes nothing anywhere else; drag it to the Dock from
# here to keep it there.

set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
binary=${1:-$repo/tui/target/release/pvestats-tui}
app="$repo/PVEStats Terminal.app"

[ -x "$binary" ] || { echo "no dashboard at $binary: build it first (see above)" >&2; exit 1; }
case "$(file -b "$binary")" in
    *Mach-O*) ;;
    *) echo "$binary is not a macOS program" >&2; exit 1 ;;
esac

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$repo/assets/AppIcon.icns" "$app/Contents/Resources/AppIcon.icns"
cp "$binary" "$app/Contents/Resources/pvestats-tui"

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>PVEStats Terminal</string>
  <key>CFBundleDisplayName</key><string>PVEStats Terminal</string>
  <key>CFBundleIdentifier</key><string>net.local.pvestats.terminal</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>PVEStats Terminal</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <!-- Only a launcher: it hands the dashboard to Terminal and quits, so it
       needs no Dock icon of its own. -->
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST

# The launcher opens a .command file in Terminal, which runs it in a new
# window. Through `open`, not AppleScript, so macOS never asks for
# permission to control Terminal.
cat > "$app/Contents/MacOS/PVEStats Terminal" <<'LAUNCHER'
#!/bin/bash
exec open -a Terminal "$(dirname "$0")/../Resources/dashboard.command"
LAUNCHER

# In the window: a title, a size that fits the full layout (the dashboard
# adjusts to any other), then the dashboard on this repo's settings.
cat > "$app/Contents/Resources/dashboard.command" <<COMMAND
#!/bin/bash
printf '\033]0;PVEStats\007\033[8;50;190t'
exec "\$(dirname "\$0")/pvestats-tui" --root "$repo"
COMMAND

chmod 755 "$app/Contents/MacOS/PVEStats Terminal" "$app/Contents/Resources/dashboard.command" \
    "$app/Contents/Resources/pvestats-tui"
echo "built $app"
