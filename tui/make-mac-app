#!/usr/bin/env bash
# Builds "PVEStats Terminal.app" in the repo root: the terminal dashboard in
# a window of its own on the Mac. The app is the window, a SwiftTerm
# terminal (tui/mac) running the dashboard, so the Dock, the app switcher
# and the menu bar all say PVEStats, with its icon. The dashboard redraws to
# fit whenever the window is resized; q, Esc or Cmd-Q closes it.
#
#   tui/make-mac-app
#
# Builds both programs for macOS first, at low priority: the dashboard
# (cargo, in tui/) and the window (swift, in tui/mac), with their caches
# inside the repo. That takes a Mac: macserver, not Frank's laptop, except
# when he says so. The app reads .env and config.yaml from this repo; it
# writes nothing anywhere else. Drag it to the Dock from here to keep it.
# The first time it runs, macOS asks to let it reach the local network,
# where the agents are.

set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
app="$repo/PVEStats Terminal.app"

echo "== the dashboard"
(cd "$repo/tui" && CARGO_HOME="$PWD/.cargo-home" nice -n 15 cargo build --release -j 4 --quiet)
echo "== the window"
(cd "$repo/tui/mac" && CLANG_MODULE_CACHE_PATH="$PWD/.build/module-cache" nice -n 15 swift build -c release -j 4 \
    --scratch-path .build --cache-path .swiftpm/cache --config-path .swiftpm/config \
    --security-path .swiftpm/security --manifest-cache local --quiet)

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$repo/tui/mac/.build/release/PVEStatsTerminal" "$app/Contents/MacOS/PVEStatsTerminal"
cp "$repo/tui/target/release/pvestats-tui" "$app/Contents/Resources/pvestats-tui"
cp "$repo/assets/AppIcon.icns" "$app/Contents/Resources/AppIcon.icns"

# PVEStatsRoot: the repo whose .env and config.yaml the dashboard reads.
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>PVEStats</string>
  <key>CFBundleDisplayName</key><string>PVEStats Terminal</string>
  <key>CFBundleIdentifier</key><string>net.local.pvestats.terminal</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>PVEStatsTerminal</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- App Nap would stall the dashboard's polling while the window is in
       the background. -->
  <key>LSAppNapIsDisabled</key><true/>
  <key>NSLocalNetworkUsageDescription</key>
  <string>PVEStats reads its agents on the Proxmox host, ml60, TrueNAS and the router.</string>
  <key>PVEStatsRoot</key><string>$repo</string>
</dict>
</plist>
PLIST

chmod 755 "$app/Contents/MacOS/PVEStatsTerminal" "$app/Contents/Resources/pvestats-tui"
# The icon macOS 26 draws at full size, beside the .icns (tools/app-icon).
"$repo/tools/app-icon" "$app" 13.0
# Signed ad hoc as a whole, so macOS treats the bundle as one app.
codesign --force --deep --sign - "$app" 2>/dev/null
echo "built $app"
