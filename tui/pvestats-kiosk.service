# The PVEStats dashboard on tty1 in a full-screen terminal. cage shows one
# program and nothing else; that program is foot, a terminal that draws the
# fine graphs, any font size and the true colours the text console cannot.
# Install steps are in tui/README.md.

[Unit]
Description=PVEStats dashboard on tty1 (full-screen terminal)
Wants=network-online.target
After=network-online.target systemd-user-sessions.service systemd-logind.service
After=getty@tty1.service pvestats-tui.service
Conflicts=getty@tty1.service pvestats-tui.service

[Service]
User=frank
# A login session on tty1, so cage may take the screen and keyboard.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# -s keeps Ctrl+Alt+F2 and on working.
ExecStart=/usr/bin/cage -s -- /usr/bin/foot --config=/home/frank/Projects/PVEStats/tui/foot.ini /home/frank/Projects/PVEStats/tui/bin/pvestats-tui
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
