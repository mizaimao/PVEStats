#!/usr/bin/env bash
# Build the terminal dashboard on the build machine and put it on the screen
# machine, where it restarts with the new version.
#
#   tui/deploy           test, build, copy, restart
#   tui/deploy --check   show the machines it would use and test the logins
#
# The machines come from tui/deploy.conf, which is git-ignored: copy
# tui/deploy.conf.example and fill it in. Nothing about them is written here.
#
# What it does:
#   1. Copies tui/ and certs/ to BUILD_DIR on BUILD_HOST, and runs the tests
#      and a release build there, with cargo's cache inside that folder.
#      A failing test stops the deploy.
#   2. Copies the working tree to SCREEN_DIR on SCREEN_HOST by tar over ssh,
#      so the screen machine needs nothing but ssh. That includes .env and
#      config.yaml, which the dashboard reads. Build output, caches and the
#      app's local settings (ui.json) stay behind.
#   3. Streams the binary from the build machine to SCREEN_DIR/tui/bin and
#      swaps it in with a rename, so the running copy is never overwritten.
#   4. Stops the running dashboard. Its service (systemd, Restart=always)
#      starts the new one two seconds later.
#
# It never uses sudo and never prints the contents of .env.

set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/machines.sh"

if [ "${1:-}" = "--check" ]; then
    echo "build:  $BUILD_HOST:$BUILD_DIR"
    echo "screen: $SCREEN_HOST:$SCREEN_DIR"
    on_build true && echo "build login ok"
    on_screen true && echo "screen login ok"
    exit 0
fi

echo "== test and build on $BUILD_HOST"
on_build "mkdir -p \"$B\""
pack ./tui ./certs | on_build "tar -xf - -C \"$B\""
on_build "cd \"$B/tui\" && bash ./kiosk-remote.test \
    && export CARGO_HOME=\"\$PWD/.cargo-home\" PATH=\"\$HOME/.cargo/bin:\$PATH\" \
    && cargo test --release --quiet && cargo build --release --quiet"

echo "== copy to $SCREEN_HOST"
on_screen "mkdir -p \"$S/tui/bin\""
pack . | on_screen "tar -xf - -C \"$S\""
on_build "cat \"$B/tui/target/release/pvestats-tui\"" \
    | on_screen "cd \"$S/tui/bin\" && cat > pvestats-tui.new && chmod 755 pvestats-tui.new \
        && mv pvestats-tui.new pvestats-tui"

echo "== restart"
on_screen "pkill -x pvestats-tui || true; sleep 5; \
    if pid=\$(pgrep -x pvestats-tui); then echo \"running again, pid \$pid\"; \
    else echo 'not running: is its service installed? see tui/README.md'; exit 1; fi"
