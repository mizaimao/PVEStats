#!/usr/bin/env bash
# Build the terminal dashboard on the build machine and put it on the screen
# machine, where it restarts with the new version.
#
#   tui/deploy           test, build, copy, restart
#   tui/deploy --check   show the machines it would use and test the logins
#   tui/deploy --force   the same, even while the kiosk's dashboard is
#                        paused or stopped (only with Frank's OK)
#
# The machines come from tui/deploy.conf, which is git-ignored: copy
# tui/deploy.conf.example and fill it in. Nothing about them is written here.
#
# What it does:
#   1. Copies tui/ and certs/ to BUILD_DIR on BUILD_HOST, and runs the tests
#      and a release build there, with cargo's cache inside that folder.
#      A failing test stops the deploy.
#   2. Copies the working tree to SCREEN_DIR on SCREEN_HOST by tar over ssh,
#      so the screen machine needs nothing but ssh. That includes .env and
#      config.yaml, which the dashboard reads. Build output, caches and the
#      app's local settings (ui.json) stay behind.
#   3. Streams the binary from the build machine to SCREEN_DIR/tui/bin and,
#      once its checksum matches the build's, swaps it in with a rename, so
#      the running copy is never overwritten.
#   4. Stops the running dashboard, paused or not. Its service (systemd,
#      Restart=always) starts the new one two seconds later.
#
# It never uses sudo and never prints the contents of .env.

set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/../tools/machines.sh"

# tui/kiosk-remote's tests run under a UTF-8 locale, as a client may set
# one. moose-mcp's key runs a root-owned copy Frank installs from a reviewed
# commit (MOO-200), never the one deploys copy.
gatekeeper_test="cd \"$B/tui\" && LANG=C.UTF-8 LC_ALL=C.UTF-8 bash ./kiosk-remote.test"

if [ "${1:-}" = "--check" ]; then
    echo "build:  $BUILD_HOST:$BUILD_DIR"
    echo "screen: $SCREEN_HOST:$SCREEN_DIR"
    on_build true && echo "build login ok"
    on_screen true && echo "screen login ok"
    exit 0
fi

# Frank pauses the kiosk (tui/kiosk off) to measure power, or leaves it
# stopped; a deploy would turn it back on, or copy a version with nothing
# to start it. So it stops here first and says so, unless --force. A
# screen machine that cannot say (no kiosk-remote there yet) goes ahead.
state=$(on_screen "\"$S/tui/kiosk-remote\" status" 2>/dev/null || true)
dashboard=$(printf '%s' "$state" | sed -n 's/.*"dashboard":"\([a-z]*\)".*/\1/p')
case $dashboard in
    paused | stopped)
        if [ "${1:-}" != "--force" ]; then
            echo "the kiosk's dashboard is $dashboard: ask Frank before deploying (tui/deploy --force to go ahead)" >&2
            exit 2
        fi ;;
esac

echo "== test and build on $BUILD_HOST"
send_to_build ./tui ./certs
on_build "$gatekeeper_test"
remote_cargo tui

echo "== copy to $SCREEN_HOST"
on_screen "mkdir -p \"$S/tui/bin\""
pack . | on_screen "tar -xf - -C \"$S\""
# Swapped in only once its checksum matches the build's: a copy cut short
# (the build machine's ssh dropping) ends the screen side's input as if it
# were whole, and would be renamed over the working binary.
sum=$(on_build "sha256sum \"$B/tui/target/release/pvestats-tui\"" | cut -d' ' -f1)
[[ $sum =~ ^[0-9a-f]{64}$ ]] || { echo "no checksum of the build" >&2; exit 1; }
on_build "cat \"$B/tui/target/release/pvestats-tui\"" \
    | on_screen "cd \"$S/tui/bin\" && cat > pvestats-tui.new \
        && { echo '$sum  pvestats-tui.new' | sha256sum -c --quiet - || { rm -f pvestats-tui.new; exit 1; }; } \
        && chmod 755 pvestats-tui.new && mv pvestats-tui.new pvestats-tui"

echo "== restart"
# A dashboard paused by `tui/kiosk off` holds the TERM until it is continued,
# so it gets a CONT too; and only a new process counts as restarted.
on_screen "old=\$(pgrep -x pvestats-tui); pkill -x pvestats-tui; pkill -CONT -x pvestats-tui; sleep 5; \
    if pid=\$(pgrep -x pvestats-tui) && [ \"\$pid\" != \"\$old\" ]; then echo \"running again, pid \$pid\"; \
    else echo 'not restarted: is its service installed? see tui/README.md'; exit 1; fi"
