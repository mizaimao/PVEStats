#!/usr/bin/env bash
# Tests for tui/kiosk-remote's gate: what it lets through, what it refuses,
# and that a refusal is one line of JSON and exit 2. Changes nothing: only
# the parsing is run. tui/deploy runs it on the build machine.

. "$(cd "$(dirname "$0")" && pwd)/kiosk-remote"
failures=0

expect() {
    local want_rc=$1 want_out=$2 request=$3 out rc
    out=$(parse "$request"); rc=$?
    if [ "$rc" != "$want_rc" ] || [ "$out" != "$want_out" ]; then
        printf 'FAIL %q: got %s %q, wanted %s %q\n' "$request" "$rc" "$out" "$want_rc" "$want_out"
        failures=$((failures + 1))
    fi
}
allowed() { expect 0 "${2:-$1}" "$1"; }
refused() { expect 2 "{\"error\":\"refused: ${2:-not a kiosk command}\"}" "$1"; }

for c in status "dashboard pause" "dashboard resume" "monitor off" "monitor on" \
    "kiosk off" "kiosk on" "schedule show" "schedule clear"; do
    allowed "$c"
done
allowed "  monitor   off " "monitor off"
allowed "schedule set 03:00-05:00"
allowed "schedule set 23:30-06:00"
allowed "schedule set 00:00-23:59"
allowed "report"

# Anything a shell could act on never gets as far as the word match.
for r in "" " " "status;reboot" "status && reboot" 'status $(reboot)' 'status `id`' \
    "status | sh" "status > /tmp/x" "STATUS" "monitor off
reboot" "monitor	off" "status #" "../status" "monitor off --on" \
    "status ................................................"; do
    refused "$r"
done
refused "monitor"
refused "monitor brightness"
refused "report now"
refused "reports"
refused "dashboard stop"
refused "kiosk restart"
refused "status now"
refused "reboot"
refused "systemctl stop pvestats-kiosk"
refused "schedule"
refused "schedule set"
refused "schedule set 24:00-05:00" "the window is HH:MM-HH:MM"
refused "schedule set 03:60-05:00" "the window is HH:MM-HH:MM"
refused "schedule set 3:00-05:00" "the window is HH:MM-HH:MM"
refused "schedule set 03:00" "the window is HH:MM-HH:MM"
refused "schedule set 03:00-05:00-07:00" "the window is HH:MM-HH:MM"
refused "schedule set 05:00-05:00" "the window starts and ends at the same time"
refused "schedule set 03:00-05:00 07:00-08:00" "schedule set takes one window"
refused "schedule set 03:00 - 05:00" "schedule set takes one window"

# Other scripts' digits and letters: the script matches byte-wise whatever
# locale the client sets (this file is run under a UTF-8 one by deploy).
refused "schedule set ٠٣:٠٠-٠٥:٠٠"
refused "monitor öff"
refused $'status\xc2\xa0'  # a non-breaking space

# Windows as the dashboard's config.rs hours() reads them.
usable() {
    if ! usable_window "$1"; then printf 'FAIL usable %q\n' "$1"; failures=$((failures + 1)); fi
}
unusable() {
    if usable_window "$1"; then printf 'FAIL unusable %q\n' "$1"; failures=$((failures + 1)); fi
}
usable "03:00-05:00"
usable "3:00-5:00"
usable " 03:00 - 05:00 "
usable "08:09-09:08"
usable "23:30-06:00"
unusable "05:00-05:00"
unusable "5:00-05:00"
unusable "24:00-01:00"
unusable "03:60-05:00"
unusable "03:00"
unusable "none"
unusable ""

# The script makes matching byte-wise itself, whatever locale it starts in.
[ "$LC_ALL" = C ] || { echo "FAIL LC_ALL is $LC_ALL after sourcing"; failures=$((failures + 1)); }

# main's own paths, with the machine left out: a repo folder of its own, no
# display, and the dashboard stood in for.
tmp=$(mktemp -d)
mkdir "$tmp/tui"
ROOT=$tmp OVERRIDE=$tmp/tui/screen_off.local CONFIG=$tmp/config.yaml
printf 'ui:\n  screen_off: "01:00-02:00"\ntui:\n  screen_off: "03:00-05:00"  # nightly\n' > "$CONFIG"
randr() { return 1; }
check() {
    local out rc
    out=$(SSH_ORIGINAL_COMMAND="$1" main); rc=$?
    if [ "$rc $out" != "$2" ]; then
        printf 'FAIL main %q: got %s\n     wanted %s\n' "$1" "$rc $out" "$2"
        failures=$((failures + 1))
    fi
}
state_json() { printf '{"dashboard":"%s","monitor":"unknown","schedule":%s,"schedule_from":"%s"}' "$@"; }

dashboard_pid() { return 0; }   # not running
check status "0 $(state_json stopped '"03:00-05:00"' config.yaml)"
check "dashboard pause" '1 {"error":"the dashboard is not running"}'
check "kiosk off" '1 {"error":"the dashboard is not running"}'
check "monitor off" '1 {"error":"could not switch the monitor off; it is now unknown"}'
check "schedule set 22:00-06:30" "0 $(state_json stopped '"22:00-06:30"' override)"
check "schedule clear" "0 $(state_json stopped null override)"
check "status; id" '2 {"error":"refused: not a kiosk command"}'

dashboard_pid() { return 3; }   # two running: nothing done to either
check status "0 $(state_json unknown null override)"
check "dashboard resume" '1 {"error":"more than one dashboard is running"}'
check "kiosk on" '1 {"error":"more than one dashboard is running"}'

# The report: run as is, with the session bus set, and needing no lock.
REPORT=$tmp/none
check report '1 {"error":"the report is not installed"}'
REPORT=$tmp/report
printf '#!/bin/bash\nprintf "{\\"bus\\":\\"%%s\\"}\\n" "$DBUS_SESSION_BUS_ADDRESS"\n' > "$REPORT"
chmod 755 "$REPORT"
check report "0 {\"bus\":\"unix:path=/run/user/$(id -u)/bus\"}"

exec 8< "$tmp/tui"; flock -n 8   # another command holds the lock
check status '1 {"error":"busy: another kiosk command is running"}'
exec 8<&-

ROOT=$tmp/missing
check status "1 {\"error\":\"the kiosk's repo is not there\"}"
rm -rf "$tmp"

if [ "$failures" -eq 0 ]; then echo "kiosk-remote: all passed"; else exit 1; fi
