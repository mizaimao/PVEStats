#!/usr/bin/env bash
# Tests the ml60 agent (agent/rust) and builds it on the build machine named
# in tui/deploy.conf, then copies the program to agent/bin/pvestats-agent.
# Installing it on ml60 is a separate step with sudo, for Frank: see
# agent/README.md.
#
# NVIDIA's library is loaded at run time, which needs a glibc build (a
# static musl one cannot load it), so the program needs a glibc on ml60 at
# least as new as the newest symbol version it uses; the last line says
# which.
set -euo pipefail
. "$(dirname "$0")/../tools/machines.sh"

echo "== test and build on $BUILD_HOST"
send_to_build ./agent/rust
remote_cargo agent/rust
fetch_binary agent/rust/target/release/pvestats-agent agent/bin/pvestats-agent
echo "== needs glibc $(glibc_needed agent/rust/target/release/pvestats-agent) or newer"
