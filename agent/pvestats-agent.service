[Unit]
Description=PVEStats GPU agent (NVML + Ollama)
After=network-online.target
Wants=network-online.target

# Give up after 10 failures in 5 minutes rather than restarting forever. An
# unattended crash loop writes journal lines to ml60's disk indefinitely,
# which is the kind of write constraint 3 exists to prevent.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Must match the user Ollama runs as, or be root. Otherwise NVML cannot see
# other users' compute processes and procs[] comes back empty (spec §3.2).
User=ollama
Group=ollama

ExecStart=/opt/pvestats-agent/.venv/bin/python /opt/pvestats-agent/agent.py
Restart=always
RestartSec=5

# --- keep this service off ml60's disk ---
# Nothing is persisted: NVML handle and the Ollama model cache live in memory
# and are rebuilt on start. What remains are incidental writes, closed here.

# Python writes .pyc on first import. ProtectSystem=strict already makes that
# fail, but this avoids the pointless syscalls.
Environment=PYTHONDONTWRITEBYTECODE=1

# Both startup messages go to stderr, so stdout has nothing to carry and its
# journal writes are pure overhead. stderr is kept: it is two lines per start
# plus a traceback if the thing dies, which is worth having on disk.
StandardOutput=null
StandardError=journal
# For literally zero journal writes, swap the line above for:
#   StandardError=null
# The cost is that a crash becomes silent — `systemctl status` shows the exit
# code and nothing else.

# No socket activation, deliberately: NVML re-initialisation on each wake
# costs more than the ~20 MB this process idles at (spec §3.2).

NoNewPrivileges=true
# The whole filesystem is read-only to this unit, so a stray write cannot
# reach ml60's disk even if the code changes.
ProtectSystem=strict
ProtectHome=true
# Private /tmp and /var/tmp, both tmpfs — memory-backed, never the disk.
PrivateTmp=true
# PrivateDevices is NOT set — NVML needs /dev/nvidia*.

[Install]
WantedBy=multi-user.target
