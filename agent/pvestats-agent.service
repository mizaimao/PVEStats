[Unit]
Description=PVEStats GPU agent (NVML + Ollama)
After=network-online.target
Wants=network-online.target

# Give up after 10 failures in 5 minutes rather than restarting forever. An
# unattended crash loop writes journal lines to ml60's disk indefinitely,
# which is the kind of write constraint 3 exists to prevent.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Do not edit this file on the host: updates replace it. Put local settings
# (a different User=, an Environment= line) in a drop-in instead:
#   sudo systemctl edit pvestats-agent
# Must match the user Ollama runs as, or be root. Otherwise NVML cannot see
# other users' compute processes and procs[] comes back empty (spec §3.2).
User=ollama
Group=ollama

ExecStart=/opt/pvestats-agent/.venv/bin/python /opt/pvestats-agent/agent.py
Restart=always
RestartSec=5

# --- keep this service off ml60's disk ---
# Nothing is persisted: NVML handle and the Ollama model cache live in memory
# and are rebuilt on start. What remains are incidental writes, closed here.

# Python writes .pyc on first import. ProtectSystem=strict already makes that
# fail, but this avoids the pointless syscalls.
Environment=PYTHONDONTWRITEBYTECODE=1
# The agent will honour a "stop this model" request from the dashboard, which
# sets keep_alive=0 on it — the same thing `ollama stop` does. Nothing else on
# this host is writable through the agent. To refuse those requests and make
# the agent strictly read-only, add this line in a drop-in (see above), not
# here, so an update cannot quietly reopen it:
#   Environment=PVESTATS_AGENT_ALLOW_UNLOAD=0

# Both startup messages go to stderr, so stdout has nothing to carry and its
# journal writes are pure overhead. stderr is kept: it is two lines per start
# plus a traceback if the thing dies, which is worth having on disk.
StandardOutput=null
StandardError=journal
# For literally zero journal writes, swap the line above for:
#   StandardError=null
# The cost is that a crash becomes silent — `systemctl status` shows the exit
# code and nothing else.

# No socket activation, deliberately: NVML re-initialisation on each wake
# costs more than the ~20 MB this process idles at (spec §3.2).

NoNewPrivileges=true
# The whole filesystem is read-only to this unit, apart from the API trees
# (/dev, /proc, /sys) and the temp dirs below, so a stray write cannot reach
# ml60's disk even if the code changes.
ProtectSystem=strict
ProtectHome=true
# /tmp and /var/tmp of its own, each a fresh tmpfs: memory-backed, never the
# disk. PrivateTmp=true would not do this: it keeps the private dirs inside
# the host's /tmp and /var/tmp, and /var/tmp is on disk. Needs systemd 238+.
TemporaryFileSystem=/tmp:mode=1777 /var/tmp:mode=1777
# PrivateDevices is NOT set — NVML needs /dev/nvidia*.

[Install]
WantedBy=multi-user.target
