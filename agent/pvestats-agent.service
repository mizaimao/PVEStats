[Unit]
Description=PVEStats GPU agent (NVML + Ollama)
After=network-online.target
Wants=network-online.target

# Give up after 10 failures in 5 minutes rather than restarting forever. An
# unattended crash loop writes journal lines to ml60's disk indefinitely,
# which is the kind of write constraint 3 exists to prevent.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Do not edit this file on the host: updates replace it. Put local settings
# (a different User=, an Environment= line) in a drop-in instead:
#   sudo systemctl edit pvestats-agent
# Must match the user Ollama runs as, or be root. Otherwise NVML cannot see
# other users' compute processes and procs[] comes back empty (spec §3.2).
User=ollama
Group=ollama

# The Rust agent (agent/rust); the Python one it replaces ran as
#   ExecStart=/opt/pvestats-agent/.venv/bin/python /opt/pvestats-agent/agent.py
ExecStart=/opt/pvestats-agent/pvestats-agent
Restart=always
RestartSec=5

# --- keep this service off ml60's disk ---
# Nothing is persisted: NVML handle and the Ollama model cache live in memory
# and are rebuilt on start. What remains are incidental writes, closed here.

# The agent will honour a "stop this model" request from the dashboard, which
# sets keep_alive=0 on it — the same thing `ollama stop` does. Nothing else on
# this host is writable through the agent. To refuse those requests and make
# the agent strictly read-only, add this line in a drop-in (see above), not
# here, so an update cannot quietly reopen it:
#   Environment=PVESTATS_AGENT_ALLOW_UNLOAD=0

# Both startup messages go to stderr, so stdout has nothing to carry and its
# journal writes are pure overhead. stderr is kept: it is two lines per start,
# which is worth having on disk.
StandardOutput=null
StandardError=journal
# For literally zero journal writes, swap the line above for:
#   StandardError=null
# The cost is that a crash becomes silent — `systemctl status` shows the exit
# code and nothing else.

# No socket activation, deliberately: NVML re-initialisation on each wake
# costs more than keeping this small process running (spec §3.2).

# Bounds, should anything ever go wrong: the agent itself holds at most 16
# connections and a handful of threads. No core files: a crash loop would
# otherwise write one to disk each time. (No MemoryMax: a cgroup memory cap
# set off a kernel crash on ml60 on 2026-10-21.)
LimitNOFILE=256
TasksMax=64
LimitCORE=0

NoNewPrivileges=true
# The whole filesystem is read-only to this unit, apart from the API trees
# (/dev, /proc, /sys) and the temp dirs below, so a stray write cannot reach
# ml60's disk even if the code changes.
ProtectSystem=strict
ProtectHome=true
# /tmp and /var/tmp of its own, each a fresh tmpfs: memory-backed, never the
# disk. PrivateTmp=true would not do this: it keeps the private dirs inside
# the host's /tmp and /var/tmp, and /var/tmp is on disk. Needs systemd 238+.
TemporaryFileSystem=/tmp:mode=1777,size=16M /var/tmp:mode=1777,size=16M
# PrivateDevices is NOT set — NVML needs /dev/nvidia*. Nor is ProtectClock:
# it implies DeviceAllow=char-rtc, which closes every other device, the
# GPU's with them. Nor MemoryDenyWriteExecute, for NVIDIA's library, nor
# ProtectProc: the GPU's processes of other users are named from /proc.

# --- what a fault in the agent or in NVIDIA's library could reach ---
# It runs as ollama, so without these it could read Ollama's own files
# (its key and models, under its home) and talk to anything on the network.
# It talks only on loopback: Caddy in front, Ollama behind. Finding its
# own address connects a UDP socket, which sends nothing.
InaccessiblePaths=-/usr/share/ollama/.ollama
IPAddressDeny=any
IPAddressAllow=localhost
# AF_UNIX for nvidia-persistenced's socket, which NVML may use; AF_NETLINK
# for glibc's look-ups, should a drop-in give OLLAMA_URL a name.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# A drop-in that binds the agent to a LAN address (PVESTATS_AGENT_BIND)
# must allow its clients too, e.g. IPAddressAllow=10.10.10.0/24.

[Install]
WantedBy=multi-user.target
