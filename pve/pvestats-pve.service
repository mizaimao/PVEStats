[Unit]
Description=PVEStats host agent (the host's and VMs' counters, read-only)
After=network-online.target
Wants=network-online.target

# Give up after 10 failures in 5 minutes rather than restarting forever: an
# unattended crash loop would write journal lines to the host's disk.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Do not edit this file on the host: updates replace it. Local settings go
# in a drop-in (sudo systemctl edit pvestats-pve).
#
# A user of its own that exists only while the service runs: everything the
# agent reads (/proc, the VMs' cgroup files, the tap devices' counters) is
# readable by any user. DynamicUser also makes the whole filesystem
# read-only to it and gives it a private /tmp.
DynamicUser=yes
ExecStart=/usr/local/bin/pvestats-pve --listen 10.10.10.100:9838
Restart=always
RestartSec=5

# Nothing per request reaches the journal; a start or a failure is a line or
# two on stderr, worth keeping.
StandardOutput=null
StandardError=journal

# Bounds, should anything go wrong: the agent itself serves at most 4
# clients, a thread each. No core files: a crash loop would write one each
# time. No MemoryMax: a cgroup memory cap set off a kernel crash on ml60
# on 2026-10-21, and the agent holds about 2 MB.
LimitNOFILE=64
TasksMax=16
LimitCORE=0

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
# ProtectProc and ProcSubset stay unset: the agent reads each VM's QEMU
# process (/proc/PID/stat and comm, for its uptime) and /proc/stat itself.

[Install]
WantedBy=multi-user.target
