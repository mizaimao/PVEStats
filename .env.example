# Copy to .env and fill in. .env is git-ignored (spec §6).
# Credentials are read by the collector at startup and never reach the page.

# --- Proxmox VE ---
# Host or IP only, no scheme, no port. Port 8006 is assumed.
PVE_HOST=pve.lan
# Optional. If unset, the probe/collector discovers it from /nodes.
PVE_NODE=
# Token created per spec §6:
#   pveum user add dash@pve
#   pveum aclmod / -user dash@pve -role PVEAuditor
#   pveum user token add dash@pve web --privsep 0
PVE_TOKEN_ID=dash@pve!web
PVE_TOKEN_SECRET=

# --- TrueNAS ---
# Host or IP only, no scheme. Port 443 is assumed.
TRUENAS_HOST=nas.lan
# Generated in the TrueNAS UI under the account's API Keys page, not the shell.
TRUENAS_API_KEY=

# --- ml60 agent ---
# Served by Caddy on ml60, verified against certs/home-root.crt.
ML60_AGENT_URL=https://pvestats.ml60.lan/

# --- Router agent (router/), for both dashboards ---
# Plain HTTP on the router's LAN address. Leave empty until it is installed:
# with none, neither dashboard shows a router card.
ROUTER_AGENT_URL=

# --- Proxmox host agent (pve/), for the terminal dashboard ---
# Plain HTTP on the host's LAN address, e.g. http://10.10.10.100:9838/. With
# it, the host's and guests' live figures come from it every 2 s and PVE's
# API is asked every 30 s (also while the agent is down, when PVE's figures
# are shown again, at that pace); leave empty until it is installed.
PVE_AGENT_URL=

# --- TrueNAS agent (nas/), for the terminal dashboard ---
# Plain HTTP on TrueNAS's LAN address, e.g. http://10.10.10.2:9839/. With
# it, the TrueNAS card reads only the agent, every 2 s, and TrueNAS's API
# and PVE are not asked for it; leave empty until it is installed.
NAS_AGENT_URL=

# --- Local server ---
# Binds 127.0.0.1 only. No auth (spec §5).
DASHBOARD_PORT=8080

# Weather for the terminal dashboard (tui/), from Open-Meteo: free, no key.
# A place name to look up, or coordinates (which win). Units: metric (°C,
# km/h, mm, the default) or imperial (°F, mph, in).
WEATHER_PLACE=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_UNITS=metric
