#!/usr/bin/env bash
# Builds pvestats-server for the Mac it runs on, into server/bin/, where
# app.py looks for it. Run it on macserver (Apple silicon like Frank's
# laptop), never on the laptop itself; then copy server/bin/pvestats-server
# into the laptop's copy of the repo. With no server/bin/pvestats-server,
# app.py runs the Python collector as before.
#
# Cargo's cache stays inside the repo (server/.cargo-home).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
cd "$here"
export CARGO_HOME="$here/.cargo-home"
cargo test --release --quiet
cargo build --release --quiet
mkdir -p bin
cp target/release/pvestats-server bin/pvestats-server.new
mv bin/pvestats-server.new bin/pvestats-server
echo "built server/bin/pvestats-server ($(wc -c < bin/pvestats-server | tr -d ' ') bytes) for $(uname -sm)"
