# Credentials — never committed (spec §6)
.env

# Raw source captures. No tokens in these, but they do contain homelab
# topology: hostnames, pool names, disk serials, guest inventory.
captures/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generated app bundle — build it with make-app.command
PVEStats.app/
# The terminal dashboard as a Mac app — build it with tui/make-mac-app
PVEStats Terminal.app/

# Appearance settings written by the settings panel
ui.json

# Reference wallpapers — sampled for theme colours, not shipped
*.jpg

# macOS
.DS_Store

# uv, the Python it manages and its cache. Fetched by tools/uv. No trailing
# slash, so a .tools link is ignored too.
.tools

# PNGs from tools/render_icon.py
icons/

# The terminal dashboard's build output and its cargo cache
tui/target/
tui/.cargo-home/
tui/bin/
tui/deploy.conf
tui/shot/target/

# The router agent's build output, its cargo cache and the built program
router/agent/target/
router/agent/.cargo-home/
router/bin/

# The Proxmox host agent's build output, its cargo cache and the built program
pve/agent/target/
pve/agent/.cargo-home/
pve/bin/

# The TrueNAS agent's build output, its cargo cache and the built program
nas/agent/target/
nas/agent/.cargo-home/
nas/bin/

# The ml60 agent's build output, its cargo cache and the built program
agent/rust/target/
agent/rust/.cargo-home/
agent/bin/

# The Rust server's build output, its cargo cache and the built program
server/target/
server/.cargo-home/
server/bin/

# The kiosk's screen-off window set from afar (tui/kiosk-remote), kept on the
# screen machine across deploys
tui/screen_off.local*

# The Mac app's window (tui/mac): swift's build output and caches
tui/mac/.build/
tui/mac/.swiftpm/
