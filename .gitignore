# Credentials — never committed (spec §6)
.env

# Raw source captures. No tokens in these, but they do contain homelab
# topology: hostnames, pool names, disk serials, guest inventory.
captures/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generated app bundle — build it with make-app.command
PVEStats.app/

# Appearance settings written by the settings panel
ui.json

# Reference wallpapers — sampled for theme colours, not shipped
*.jpg

# macOS
.DS_Store

# uv, the Python it manages and its cache. Fetched by tools/uv. No trailing
# slash, so a .tools link is ignored too.
.tools

# PNGs from tools/render_icon.py
icons/
