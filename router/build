#!/usr/bin/env bash
# Tests the router agent and builds it for the router (64-bit ARM, a static
# musl program) on the build machine named in tui/deploy.conf, then copies
# the program to router/bin/pvestats-router. Installing it on the router is
# a separate step, only with Frank's go-ahead: see router/README.md.
#
# The build machine needs the target once:
#   rustup target add aarch64-unknown-linux-musl
set -euo pipefail
. "$(dirname "$0")/../tui/machines.sh"

echo "== test and build on $BUILD_HOST"
on_build "mkdir -p \"$B\""
pack ./router | on_build "tar -xf - -C \"$B\""
on_build "cd \"$B/router/agent\" && export CARGO_HOME=\"\$PWD/.cargo-home\" PATH=\"\$HOME/.cargo/bin:\$PATH\" \
    && cargo test --release --quiet && cargo build --release --quiet --target aarch64-unknown-linux-musl"

mkdir -p "$repo/router/bin"
on_build "cat \"$B/router/agent/target/aarch64-unknown-linux-musl/release/pvestats-router\"" \
    >"$repo/router/bin/pvestats-router.new"
chmod 755 "$repo/router/bin/pvestats-router.new"
mv "$repo/router/bin/pvestats-router.new" "$repo/router/bin/pvestats-router"
echo "== built router/bin/pvestats-router ($(wc -c <"$repo/router/bin/pvestats-router" | tr -d ' ') bytes)"
