#!/usr/bin/env bash
# Tests the TrueNAS agent and builds it on the build machine named in
# tui/deploy.conf, then copies the program to nas/bin/pvestats-nas. Running
# it on TrueNAS is a separate step, only with Frank's go-ahead: see
# nas/README.md.
#
# glibc linked in (crt-static): TrueNAS 25.10 is Debian 12, glibc 2.36, and
# a program built on the build machine's Debian 13 that starts programs
# (`zpool`, `zfs`) asks for glibc 2.39. Linked in, it needs none at all;
# it does no name lookups, the one thing static glibc does badly. A build
# that came out dynamic is not copied.
set -euo pipefail
. "$(dirname "$0")/../tools/machines.sh"

echo "== test and build on $BUILD_HOST"
send_to_build ./nas
remote_cargo nas/agent RUSTFLAGS='-C target-feature=+crt-static' --target x86_64-unknown-linux-gnu

built=nas/agent/target/x86_64-unknown-linux-gnu/release/pvestats-nas
# Static or not copied: a dynamic one would not start on TrueNAS.
kind=$(on_build "file -b \"$B/$built\"")
case "$kind" in
    *static*) ;;
    *) echo "== not static, not copied: $kind" >&2; exit 1 ;;
esac
fetch_binary "$built" nas/bin/pvestats-nas
echo "== $(echo "$kind" | cut -d, -f1-2,4)"
