#!/usr/bin/env bash
# Gives an app bundle the icon macOS 26 draws at full size. An app that
# ships only an .icns is legacy there: macOS shrinks its picture onto a tile
# of its own, smaller than Apple's apps. An asset catalog (Assets.car)
# compiled from assets/AppIcon.icon by Xcode's actool gets the full tile;
# the bundle's AppIcon.icns stays as the fallback for older macOS.
#
#   tools/app-icon APP MINIMUM_MACOS
#
# Needs Xcode (actool is not in the command line tools); without it the
# bundle keeps the .icns alone. Sign the bundle afterwards.

set -euo pipefail
app=$1 minimum=$2
repo=$(cd "$(dirname "$0")/.." && pwd)
xcode=/Applications/Xcode.app/Contents/Developer
if [ ! -d "$xcode" ]; then
    echo "no Xcode: $app keeps its .icns alone"
    exit 0
fi
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
DEVELOPER_DIR="$xcode" xcrun actool "$repo/assets/AppIcon.icon" --compile "$out" --platform macosx \
    --minimum-deployment-target "$minimum" --app-icon AppIcon \
    --output-partial-info-plist "$out/partial.plist" >/dev/null
# Only the catalog: actool's own AppIcon.icns would replace ours.
cp "$out/Assets.car" "$app/Contents/Resources/Assets.car"
plutil -replace CFBundleIconName -string AppIcon "$app/Contents/Info.plist"
